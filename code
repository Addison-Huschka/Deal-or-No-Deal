import random
casevalues = {}
value_options = [0.01, 1, 5, 10, 25, 50, 75, 100, 200, 300, 400, 500, 750, 1000, 5000, 10000, 25000, 50000, 75000, 100000, 200000, 300000, 400000, 500000, 750000, 1000000]
for number in range(1,27):
    value = random.choice(value_options)
    casevalues[number] = value
    value_options.remove(value)
print(casevalues)

user_case = int(input("Pick a case number 1-26: "))
user_case_value = casevalues.pop(user_case)
print(user_case_value)
print(casevalues)
    